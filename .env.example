# Security Patcher – Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit the .env file to version control.

# ---------------------------------------------------------------------------
# GitHub API credentials (required for remote scanning and auto-patching)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_USERNAME=your_github_username

# ---------------------------------------------------------------------------
# Target repository (owner/repo format)
# ---------------------------------------------------------------------------
TARGET_REPO=Bylerma/Security-Patcher

# ---------------------------------------------------------------------------
# Scanning defaults
# ---------------------------------------------------------------------------
# Path to a locally cloned repository for scanning
LOCAL_REPO_PATH=.

# Branch to scan by default (used by GitHubScanner)
DEFAULT_BASE_BRANCH=main

# Branch naming prefix for automated security-fix branches
BRANCH_PREFIX=fix/security-

# ---------------------------------------------------------------------------
# Output settings
# ---------------------------------------------------------------------------
# Output format for the enhanced CLI: json | csv | dict
DEFAULT_OUTPUT_FORMAT=json

# ---------------------------------------------------------------------------
# Notion integration (Phase 2 – optional)
# ---------------------------------------------------------------------------
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
